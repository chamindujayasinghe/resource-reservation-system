{
  "name": "resource-reservation-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit --passWithNoTests",
    "test:integration": "vitest run --project integration",
    "db:up": "docker compose up -d",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --env-file=.env scripts/seed.ts",
    "db:reset": "tsx --env-file=.env scripts/reset.ts && npm run db:migrate && npm run db:seed",
    "setup": "npm run db:migrate && npm run db:seed"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.56.0",
    "next": "16.4.0",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "^2.0.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prettier": "^3.9.10",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^5.0.4"
  }
}
